# Copy this file to .env.local and fill in your keys.
# Demo works with ZERO keys set (falls back to mock data automatically).

# LlamaParse — https://cloud.llamaindex.ai (free tier: ~1000 pages/day)
LLAMA_CLOUD_API_KEY=

# Mindee — https://mindee.com (free tier available)
MINDEE_API_KEY=

# OpenRouter — https://openrouter.ai/keys (reads LlamaParse markdown output
# and fills the structured field/line-item table)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# OpenAI — https://platform.openai.com/api-keys (Smesh Business Partner,
# /api/agent — required for AI tool-calling; no key = graceful error state)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI_PROVIDER selects which provider Business Partner uses: "openai" (default)
# or "gemini". Gemini's provider class exists (src/lib/ai/gemini-provider.ts)
# but isn't implemented yet — selecting it fails with a clear error instead of
# silently falling back. Leave unset to use OpenAI.
AI_PROVIDER=openai

# Gemini — reserved for the GeminiProvider implementation above, not wired up yet.
GEMINI_API_KEY=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Business Partner's SupabaseBusinessRepository (sales/products/inventory).
# Leave both blank to use MockBusinessRepository instead (dev fallback).
# SUPABASE_ANON_KEY is the anon/publishable key — server-only here (no
# NEXT_PUBLIC_ prefix), never sent to the browser. Do NOT use the
# service_role/secret key unless RLS truly requires it (Batch 2 Phase 4).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=

# Pins SupabaseBusinessRepository's "today" to the fixed Aug 2026 demo
# dataset window instead of the real wall clock. Leave unset once real,
# continuously-updated sales data replaces the seed set.
SMESH_DEMO_DATE=2026-08-31
